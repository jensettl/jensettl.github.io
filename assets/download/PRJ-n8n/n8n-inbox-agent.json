      "parameters": {
        "inputText": "={{ $json.subject }}",
        "categories": {
          "categories": [
            {
              "category": "Urgent",
              "description": "=Use this for emails requiring immediate action, strictly within 24 hours. Look for high-stakes language indicating crises, missed deadlines, service outages, security alerts, or direct requests from VIP stakeholders (e.g., \"CEO\", \"Client Emergency\").\n\nKeywords to look for: ASAP, Emergency, Immediate Attention Required, Overdue, Service Down, Security Alert, Final Notice."
            },
            {
              "category": "Invoice",
              "description": "=Use this for financial transactional emails. This includes incoming bills for payment, receipts for past payments, order confirmations, subscription renewals, and banking notifications.  Keywords to look for: Invoice, Receipt, Bill, Order Confirmation, Payment Successful, Subscription Renewed, Amount Due, PDF attachment with currency symbols."
            },
            {
              "category": "Personal",
              "description": "=Use this for direct, human-to-human correspondence that is not mass-distributed. These emails usually have a casual or conversational tone, specific context unique to the relationship, and lack \"Unsubscribe\" links.  Keywords to look for: Meeting for coffee, checking in, personal favor, specific project updates (non-urgent), introductions, family or friends."
            },
            {
              "category": "Newsletter",
              "description": "=Use this for one-to-many automated communications. This includes marketing blasts, weekly digests, webinar invites, product updates, cold sales outreach, and system notifications that do not require a response.\n\nKeywords to look for: Unsubscribe, Manage Preferences, Weekly Digest, Webinar, Offer inside, No-reply address, Sale, Update."
            }
          ]
        },
        "options": {
          "fallback": "other",
          "systemPromptTemplate": "=You are an expert Email Triage Assistant. Your task is to analyze the provided email Subject and Body and classify it into exactly ONE of the defined categories. Also take the sender email into account.\n\nSubject: {{ $json.subject }}\nText: {{ $json.text }}\nSender: {{ $json.from.value[0].address }}\nAdhere to the following rules:\n1. OUTPUT ONLY the category name (e.g., \"Urgent\"). Do not add punctuation, explanations, or conversational filler.\n2. ORDER OF PRECEDENCE: If an email fits multiple categories, choose the one highest on this list:\n   - Priority 1: Urgent (Highest Priority)\n   - Priority 2: Invoice\n   - Priority 3: Personal\n   - Priority 4: Newsletter\n3. If the email contains a bill but implies a service shut-off or immediate deadline, classify as \"Urgent\" rather than \"Invoice\".\n4. If the email is from a real human but is purely promotional or automated sales outreach, classify as \"Newsletter\"."
        }
      },
